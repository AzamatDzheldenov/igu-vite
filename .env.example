# ------------------------------------------------------------
# IGU College site runtime configuration
# Copy this file to .env on a VPS. Never commit real secrets.
# ------------------------------------------------------------

# Runtime mode
# development: local defaults are allowed.
# production: weak/default admin passwords are rejected on startup.
NODE_ENV=development

# Frontend base path.
# Use /igu-vite/ for GitHub Pages repo hosting and / for VPS/Vercel/root domains.
VITE_BASE_PATH=/

# Express server port.
PORT=4000

# SQLite database path. Keep this outside dist and back it up regularly.
DB_PATH=server/data/igu.sqlite

# Optional cookie name for the server-side admin session id.
# No JWT signing secret or separate session secret is required: sessions are
# opaque random ids stored server-side in SQLite and sent via httpOnly cookies.
SESSION_COOKIE_NAME=igu_admin_session

# Initial admin bootstrap.
# Development fallback when empty: admin / admin123.
# Production: provide these only for the first bootstrap, use a strong password,
# then rotate/remove the bootstrap variables from the deployed environment.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-this-strong-password

# Optional initial SMM bootstrap.
# Development fallback when empty: smm / smm123.
# Production: use at least 12 characters and avoid default passwords.
SMM_LOGIN=smm
SMM_PASSWORD=change-this-strong-smm-password

# Production origin protection for cookie-authenticated POST/PUT/PATCH/DELETE.
# Use the public URL that serves the frontend. ALLOWED_ORIGINS supports
# comma-separated origins for staging/admin domains.
PUBLIC_SITE_ORIGIN=https://example.edu.kg
ALLOWED_ORIGINS=https://example.edu.kg

# API/frontend URLs for deploy notes and reverse proxy configuration.
# Vite dev uses /api and /uploads proxy from vite.config.js.
PUBLIC_API_URL=https://example.edu.kg/api
PUBLIC_UPLOADS_URL=https://example.edu.kg/uploads

# Logging.
# Logs always go to stdout/stderr. Set LOG_TO_FILE=true on a VPS only when the
# process can write to ./logs. Keep false on serverless platforms like Vercel.
LOG_TO_FILE=false

# Optional Telegram notifications for new applications.
# Leave empty to only store applications in SQLite.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
