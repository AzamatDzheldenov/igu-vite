# Vercel is recommended for frontend-only deployment.
# The full Express + SQLite + uploads version should run on a VPS.
NODE_ENV=production
VITE_BASE_PATH=/

# If frontend is deployed separately, point it at an external API in future code.
# Current frontend uses same-origin /api and /uploads.
PUBLIC_API_URL=https://api.example.edu.kg/api
PUBLIC_UPLOADS_URL=https://api.example.edu.kg/uploads

