# Full production deployment on a VPS.
NODE_ENV=production
VITE_BASE_PATH=/
PORT=3000
DB_PATH=server/data/igu.sqlite
SESSION_COOKIE_NAME=igu_admin_session

# Set strong credentials only for first bootstrap, then rotate/remove them.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-a-strong-production-password
SMM_LOGIN=smm
SMM_PASSWORD=replace-with-a-strong-production-smm-password

PUBLIC_SITE_ORIGIN=https://college.example.edu.kg
ALLOWED_ORIGINS=https://college.example.edu.kg
PUBLIC_API_URL=https://college.example.edu.kg/api
PUBLIC_UPLOADS_URL=https://college.example.edu.kg/uploads
LOG_TO_FILE=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

